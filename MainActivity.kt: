
package br.com.freefirecapaia.pro

import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.compose.setContent
import androidx.compose.foundation.background
import androidx.compose.foundation.clickable
import androidx.compose.foundation.layout.*
import androidx.compose.foundation.rememberScrollState
import androidx.compose.foundation.shape.RoundedCornerShape
import androidx.compose.foundation.verticalScroll
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp

private val Background = Color(0xFF090909)
private val Panel = Color(0xFF191919)
private val Red = Color(0xFFE53935)
private val White = Color(0xFFFFFFFF)
private val Gray = Color(0xFFAAAAAA)

class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        setContent {
            MaterialTheme(
                colorScheme = darkColorScheme(
                    primary = Red,
                    background = Background,
                    surface = Panel
                )
            ) {
                CapaIAApp()
            }
        }
    }
}

@Composable
fun CapaIAApp() {
    var page by remember { mutableStateOf("Início") }

    Scaffold(
        containerColor = Background,
        bottomBar = {
            NavigationBar(
                containerColor = Panel,
                contentColor = White
            ) {
                listOf("Início", "Sensibilidade", "Treino", "Sistema")
                    .forEach { item ->
                        NavigationBarItem(
                            selected = page == item,
                            onClick = { page = item },
                            icon = {
                                Text(
                                    when (item) {
                                        "Início" -> "⌂"
                                        "Sensibilidade" -> "◎"
                                        "Treino" -> "🎯"
                                        else -> "⚙"
                                    },
                                    fontSize = 20.sp
                                )
                            },
                            label = {
                                Text(item, fontSize = 9.sp)
                            },
                            colors = NavigationBarItemDefaults.colors(
                                selectedIconColor = Red,
                                selectedTextColor = Red,
                                indicatorColor = Color(0xFF382020),
                                unselectedIconColor = Gray,
                                unselectedTextColor = Gray
                            )
                        )
                    }
            }
        }
    ) { padding ->
        Column(
            modifier = Modifier
                .fillMaxSize()
                .background(Background)
                .padding(padding)
                .verticalScroll(rememberScrollState())
                .padding(20.dp)
        ) {
            Text(
                "FREE FIRE",
                color = White,
                fontSize = 17.sp,
                fontWeight = FontWeight.Bold
            )

            Text(
                "CAPA IA PRO",
                color = Red,
                fontSize = 29.sp,
                fontWeight = FontWeight.Black
            )

            Spacer(Modifier.height(22.dp))

            when (page) {
                "Início" -> HomeScreen { page = it }
                "Sensibilidade" -> SensitivityScreen()
                "Treino" -> TrainingScreen()
                "Sistema" -> SystemScreen()
            }
        }
    }
}

@Composable
fun HomeScreen(openPage: (String) -> Unit) {
    Text(
        "PAINEL PRINCIPAL",
        color = White,
        fontSize = 20.sp,
        fontWeight = FontWeight.Bold
    )

    Spacer(Modifier.height(15.dp))

    Card(
        colors = CardDefaults.cardColors(containerColor = Panel),
        shape = RoundedCornerShape(18.dp),
        modifier = Modifier.fillMaxWidth()
    ) {
        Column(Modifier.padding(18.dp)) {
            Text("SEU DESEMPENHO", color = Red, fontWeight = FontWeight.Bold)
            Spacer(Modifier.height(8.dp))
            Text("Análise do dispositivo", color = White, fontSize = 19.sp)
            Text(
                "Execute os testes para conhecer a estabilidade do seu celular.",
                color = Gray
            )
        }
    }

    Spacer(Modifier.height(18.dp))

    FeatureCard("🎯", "SENSIBILIDADE IA",
        "Recomendações personalizadas de sensibilidade") {
        openPage("Sensibilidade")
    }

    FeatureCard("🔥", "TREINAMENTO DE MIRA",
        "Registre seus resultados e acompanhe sua evolução") {
        openPage("Treino")
    }

    FeatureCard("📱", "SISTEMA E ESTABILIDADE",
        "Consulte informações e faça diagnósticos") {
        openPage("Sistema")
    }

    Spacer(Modifier.height(18.dp))

    Text(
        "FREE FIRE CAPA IA PRO • VERSÃO 1.0",
        color = Gray,
        fontSize = 11.sp
    )
}

@Composable
fun FeatureCard(
    emoji: String,
    title: String,
    description: String,
    action: () -> Unit
) {
    Card(
        modifier = Modifier
            .fillMaxWidth()
            .padding(vertical = 7.dp)
            .clickable { action() },
        shape = RoundedCornerShape(15.dp),
        colors = CardDefaults.cardColors(containerColor = Panel)
    ) {
        Row(
            modifier = Modifier.padding(17.dp),
            verticalAlignment = Alignment.CenterVertically
        ) {
            Text(emoji, fontSize = 27.sp)
            Spacer(Modifier.width(14.dp))
            Column(Modifier.weight(1f)) {
                Text(title, color = Red, fontWeight = FontWeight.Bold)
                Text(description, color = Gray, fontSize = 12.sp)
            }
            Text("›", color = White, fontSize = 25.sp)
        }
    }
}



@Composable
fun SystemScreen() {
    Column {
        DeviceDiagnosticsScreen()

        Spacer(Modifier.height(20.dp))

        MotionMonitorScreen()
    }
}

@Composable
fun TrainingScreen() {
    var attempts by remember { mutableIntStateOf(0) }
    var hits by remember { mutableIntStateOf(0) }

    Text("TREINAMENTO DE MIRA", color = Red, fontSize = 21.sp,
        fontWeight = FontWeight.Bold)

    Spacer(Modifier.height(15.dp))

    Text("Testes registrados: $attempts", color = White)
    Text("Acertos registrados: $hits", color = White)

    Spacer(Modifier.height(15.dp))

    Button(
        onClick = { attempts++ },
        colors = ButtonDefaults.buttonColors(containerColor = Red)
    ) {
        Text("REGISTRAR TENTATIVA")
    }

    OutlinedButton(
        onClick = {
            if (hits < attempts) hits++
        }
    ) {
        Text("REGISTRAR ACERTO")
    }

    Text(
        "Registre os resultados dos seus exercícios de mira.",
        color = Gray
    )
}

@Composable
fun SystemScreen() {
    Text("DIAGNÓSTICO DO SISTEMA", color = Red,
        fontSize = 21.sp, fontWeight = FontWeight.Bold)

    Spacer(Modifier.height(15.dp))

    Text("Monitoramento básico", color = White, fontSize = 18.sp)

    Text(
        "O diagnóstico avançado de memória, temperatura e " +
        "sensores será implementado nas próximas etapas.",
        color = Gray
    )
}
